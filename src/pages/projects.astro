---
/**
 * Projects & Hardware Prototypes — /projects
 * Official catalog of student projects developed at IEEE GBPIET.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ProjectCard from '@components/cards/ProjectCard.astro';
import { projects } from '@data/projects';
---

<BaseLayout
  title="Projects & Innovation | IEEE GBPIET Student Branch"
  description="Explore autonomous robotics, embedded IoT systems, TinyML, and power engineering projects built by IEEE GBPIET student engineers."
>
  <div class="bg-[#292929] py-16 text-[#F5F5F5] sm:py-20">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Projects & Innovation /"
        subtitle="Explore the portfolio of hardware prototypes, robotics systems, and machine learning research developed by IEEE GBPIET students."
      />

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </div>
</BaseLayout>
