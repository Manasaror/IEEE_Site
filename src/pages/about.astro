---
/**
 * About Page — /about
 * Official About page for the IEEE GBPIET Student Branch.
 * Clean, structured university engineering aesthetic matching master design tokens.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import {
  BookOpen,
  Cpu,
  Users,
  Globe2,
  Compass,
  Layers,
  Trophy,
  Briefcase,
  Share2,
  ArrowRight,
  ShieldCheck,
  Zap,
} from 'lucide-react';

const missionPillars = [
  {
    title: 'Learn',
    desc: 'Cultivating foundational and advanced competencies in robotics, embedded systems, AI, and hardware design through structured, hands-on bootcamps.',
    icon: BookOpen,
    code: '01',
  },
  {
    title: 'Innovate',
    desc: 'Transforming classroom theory into production-grade hardware prototypes, algorithmic systems, and engineering solutions solving real-world challenges.',
    icon: Cpu,
    code: '02',
  },
  {
    title: 'Collaborate',
    desc: 'Uniting students across disciplines to collaborate on multi-semester engineering projects, hackathons, and peer-to-peer technical mentorship.',
    icon: Users,
    code: '03',
  },
  {
    title: 'Lead',
    desc: 'Instilling leadership, professional ethics, and organizational management skills through student-governed committees and flagship technical events.',
    icon: Compass,
    code: '04',
  },
];

const whyIeeeBenefits = [
  {
    title: 'Technical Learning',
    desc: 'Rigorous training across modern embedded architectures, PCB fabrication, robotics middleware, and signal processing.',
    icon: Layers,
  },
  {
    title: 'Networking',
    desc: 'Direct interaction with student branches, researchers, and professional members across IEEE Region 10 and worldwide.',
    icon: Globe2,
  },
  {
    title: 'Leadership',
    desc: 'Experience in executive decision-making, event management, technical project management, and team leadership.',
    icon: Compass,
  },
  {
    title: 'Workshops',
    desc: 'Priority access to high-demand labs including Altium PCB design, ROS 2 robotics, and TinyML on microcontrollers.',
    icon: Zap,
  },
  {
    title: 'Projects',
    desc: 'Join funded hardware initiatives like the Autonomous Planetary Rover, Micromouse Maze Solver, and Himalayan IoT Grid.',
    icon: Cpu,
  },
  {
    title: 'Competitions',
    desc: 'Compete in prestigious national robotics symposiums, hackathons, and IEEE paper presentations.',
    icon: Trophy,
  },
  {
    title: 'Professional Growth',
    desc: 'Enhance your career profile with IEEE credentials, verified leadership certificates, and global membership standing.',
    icon: Briefcase,
  },
  {
    title: 'Community & Mentorship',
    desc: 'Lifelong relationships with a dedicated network of alumni working across premier technology and research institutions.',
    icon: Share2,
  },
];

const ieeeHighlights = [
  {
    stat: '420,000+',
    label: 'Global Community',
    desc: 'Engineers, scientists, and students across 160+ countries collaborating worldwide.',
  },
  {
    stat: '1,300+',
    label: 'Technical Innovation',
    desc: 'Active global standards driving Wi-Fi, Ethernet, power grids and computing.',
  },
  {
    stat: '2,000+',
    label: 'Professional Development',
    desc: 'Conferences, certifications, and technical symposiums empowering engineering careers.',
  },
  {
    stat: '5M+',
    label: 'Research & Learning',
    desc: 'Peer-reviewed papers and technical literature published via IEEE Xplore.',
  },
];
---

<BaseLayout
  title="About Us | IEEE GBPIET Student Branch"
  description="Discover the vision, mission, and student engineering community of the IEEE Student Branch at Govind Ballabh Pant Institute of Engineering & Technology, Pauri Garhwal."
>
  <!-- ================================================== -->
  <!-- 1. PAGE TITLE / HERO BANNER                        -->
  <!-- ================================================== -->
  <section
    class="relative w-full overflow-hidden border-b border-[#3A3A3A] bg-[#1F1F1F] py-16 text-[#F5F5F5] sm:py-20 lg:py-24"
  >
    <div class="relative z-10 mx-auto max-w-[1280px] px-4 text-center sm:px-6 lg:px-8">
      <!-- Branch Badge -->
      <div
        class="mb-4 inline-flex items-center gap-2 rounded border border-[#1E5F88]/40 bg-[#1E5F88]/20 px-3 py-1 font-mono text-xs text-[#0077B6]"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#0077B6]"></span>
        <span>IEEE STUDENT BRANCH • STB64581</span>
      </div>

      <h1
        class="mb-4 text-3xl font-extrabold leading-tight tracking-tight text-[#F5F5F5] sm:text-5xl lg:text-6xl"
      >
        ABOUT IEEE GBPIET
      </h1>

      <p class="mx-auto max-w-2xl text-base leading-relaxed text-[#C9C9C9] sm:text-xl">
        Learn about our vision, mission and community.
      </p>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 2. INTRODUCTION (About Us /)                       -->
  <!-- ================================================== -->
  <section class="border-b border-[#3A3A3A] bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Left Column: Text -->
        <div class="lg:col-span-7">
          <SectionHeading
            title="About Us /"
            subtitle="Bridging academic curriculum with real-world engineering excellence."
          />

          <div class="space-y-5 text-base leading-relaxed text-[#C9C9C9] sm:text-lg">
            <p>
              IEEE GBPIET Student Branch is a community of students passionate about technology,
              engineering and innovation.
            </p>
            <p>
              We provide opportunities for students to develop technical skills, participate in
              workshops and competitions, build projects and connect with the global engineering
              community.
            </p>
            <p class="text-sm text-[#9CA3AF] sm:text-base">
              Affiliated with the IEEE Uttar Pradesh Section (Roorkee Sub-section) and IEEE Region
              10 (Asia-Pacific), our student branch at Govind Ballabh Pant Institute of Engineering
              & Technology, Pauri Garhwal serves as an incubation center for student engineers. We
              emphasize hands-on experimentation, multidisciplinary collaboration, and practical
              mastery.
            </p>
          </div>

          <!-- Quick Stats Indicators -->
          <div class="mt-8 grid grid-cols-2 gap-4 border-t border-[#3A3A3A] pt-8 sm:grid-cols-3">
            <div>
              <div class="font-mono text-2xl font-extrabold text-[#F5F5F5] sm:text-3xl">2014</div>
              <div class="mt-0.5 text-xs text-[#9CA3AF]">Established</div>
            </div>
            <div>
              <div class="font-mono text-2xl font-extrabold text-[#0077B6] sm:text-3xl">500+</div>
              <div class="mt-0.5 text-xs text-[#9CA3AF]">Active & Alumni Network</div>
            </div>
            <div>
              <div class="font-mono text-2xl font-extrabold text-[#F5F5F5] sm:text-3xl">R10</div>
              <div class="mt-0.5 text-xs text-[#9CA3AF]">Region 10 Affiliation</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Engineering Image -->
        <div class="lg:col-span-5">
          <div
            class="group relative overflow-hidden rounded-lg border border-[#3A3A3A] bg-[#1F1F1F] shadow-lg"
          >
            <img
              src="/images/about_engineering_bench.jpg"
              alt="IEEE GBPIET Student Engineers in Innovation Laboratory"
              class="h-[360px] w-full object-cover object-center transition-transform duration-500 group-hover:scale-105 sm:h-[420px]"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-[#1F1F1F] via-transparent to-transparent opacity-80"
            >
            </div>

            <div
              class="absolute inset-x-4 bottom-4 rounded border border-[#3A3A3A] bg-[#303030]/90 p-4 backdrop-blur-sm"
            >
              <div class="mb-1 flex items-center justify-between">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#0077B6]">
                  Innovation Laboratory
                </span>
                <span class="flex items-center gap-1 font-mono text-[10px] text-emerald-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                  GBPIET Campus
                </span>
              </div>
              <p class="line-clamp-2 text-xs text-[#C9C9C9]">
                Student engineers designing electronic circuits, sensors, and robotics subsystems.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 3. ABOUT IEEE (What is IEEE?)                      -->
  <!-- ================================================== -->
  <section class="border-b border-[#3A3A3A] bg-[#1F1F1F] py-16 text-[#F5F5F5] sm:py-20 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="About IEEE /"
        subtitle="The world's largest technical professional organization dedicated to advancing technology for humanity."
      />

      <div class="mb-12 max-w-4xl text-base leading-relaxed text-[#C9C9C9] sm:text-lg">
        <p class="mb-4">
          IEEE (Institute of Electrical and Electronics Engineers) is the trusted voice for
          engineering, computing, and technology information around the globe. Through its highly
          cited publications, conferences, technology standards, and professional and educational
          activities, IEEE inspires a global community to innovate for a better tomorrow.
        </p>
        <p class="text-sm text-[#9CA3AF] sm:text-base">
          As an IEEE student member, you are directly connected to global research repositories,
          international technical societies (such as IEEE Robotics & Automation, Computer Society,
          and Power & Energy Society), and an unrivaled network of practicing professionals.
        </p>
      </div>

      <!-- Highlights Grid -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          ieeeHighlights.map((item) => (
            <div class="flex flex-col justify-between rounded-lg border border-[#3A3A3A] bg-[#303030] p-6 transition-all duration-200 hover:-translate-y-1 hover:border-[#0077B6]">
              <div>
                <div class="mb-1 font-mono text-2xl font-extrabold text-[#0077B6] sm:text-3xl">
                  {item.stat}
                </div>
                <h3 class="mb-2 text-base font-bold text-[#F5F5F5]">{item.label}</h3>
                <p class="text-xs leading-relaxed text-[#C9C9C9]">{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 4. OUR MISSION (Learn, Innovate, Collaborate, Lead)-->
  <!-- ================================================== -->
  <section class="border-b border-[#3A3A3A] bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Our Mission /"
        subtitle="The four foundational pillars guiding every initiative, workshop, and project at IEEE GBPIET."
      />

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4">
        {
          missionPillars.map((pillar) => {
            const Icon = pillar.icon;
            return (
              <article class="group flex flex-col justify-between rounded-lg border border-[#3A3A3A] bg-[#303030] p-6 transition-all duration-200 hover:-translate-y-1 hover:border-[#0077B6]">
                <div>
                  <div class="mb-4 flex items-center justify-between">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-[#1E5F88] text-white transition-colors group-hover:bg-[#0077B6]">
                      <Icon className="w-5 h-5" />
                    </div>
                    <span class="rounded border border-[#3A3A3A] bg-[#252525] px-2 py-0.5 font-mono text-xs font-bold text-[#9CA3AF]">
                      {pillar.code}
                    </span>
                  </div>

                  <h3 class="mb-2 text-xl font-bold text-[#F5F5F5] transition-colors group-hover:text-[#1689C9]">
                    {pillar.title}
                  </h3>

                  <p class="text-sm leading-relaxed text-[#C9C9C9]">{pillar.desc}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 5. OUR VISION                                      -->
  <!-- ================================================== -->
  <section class="border-b border-[#3A3A3A] bg-[#1F1F1F] py-16 text-[#F5F5F5] sm:py-20 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Our Vision /"
        subtitle="Shaping future innovators and building a world-class student engineering collective."
      />

      <!-- Prominent Statement Block -->
      <div
        class="mb-12 rounded-lg border-y border-l-4 border-r border-[#3A3A3A] border-l-[#0077B6] bg-[#303030] p-8 sm:p-10"
      >
        <p
          class="mb-4 text-lg font-semibold leading-relaxed tracking-tight text-[#F5F5F5] sm:text-2xl"
        >
          "To be a distinguished student-led engineering collective that inspires technological
          innovation, instills professional integrity, and empowers every engineer at GBPIET to
          build transformative solutions for human advancement."
        </p>
        <div class="font-mono text-xs uppercase tracking-wider text-[#9CA3AF]">
          — Strategic Vision Statement • IEEE GBPIET Student Branch
        </div>
      </div>

      <!-- Vision Focus Areas Grid -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-[#3A3A3A] bg-[#292929] p-5">
          <div class="mb-1 font-mono text-xs font-bold uppercase text-[#0077B6]">
            01 / Objective
          </div>
          <h3 class="mb-2 text-base font-bold text-[#F5F5F5]">Building Future Engineers</h3>
          <p class="text-xs leading-relaxed text-[#C9C9C9]">
            Equipping members with industry-standard development workflows, hardware tools, and
            problem-solving mindsets.
          </p>
        </div>

        <div class="rounded-lg border border-[#3A3A3A] bg-[#292929] p-5">
          <div class="mb-1 font-mono text-xs font-bold uppercase text-[#0077B6]">
            02 / Objective
          </div>
          <h3 class="mb-2 text-base font-bold text-[#F5F5F5]">Encouraging Innovation</h3>
          <p class="text-xs leading-relaxed text-[#C9C9C9]">
            Providing project grants, components, and mentorship for ambitious prototypes and
            competitive robotics challenges.
          </p>
        </div>

        <div class="rounded-lg border border-[#3A3A3A] bg-[#292929] p-5">
          <div class="mb-1 font-mono text-xs font-bold uppercase text-[#0077B6]">
            03 / Objective
          </div>
          <h3 class="mb-2 text-base font-bold text-[#F5F5F5]">Developing Technical Excellence</h3>
          <p class="text-xs leading-relaxed text-[#C9C9C9]">
            Setting uncompromising standards for code quality, electrical verification, safety, and
            reproducible engineering design.
          </p>
        </div>

        <div class="rounded-lg border border-[#3A3A3A] bg-[#292929] p-5">
          <div class="mb-1 font-mono text-xs font-bold uppercase text-[#0077B6]">
            04 / Objective
          </div>
          <h3 class="mb-2 text-base font-bold text-[#F5F5F5]">
            Creating a Strong Engineering Community
          </h3>
          <p class="text-xs leading-relaxed text-[#C9C9C9]">
            Fostering an inclusive, lifelong collegiate network connecting student developers with
            alumni in premier tech firms.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 6. WHY JOIN US (Why IEEE? /)                       -->
  <!-- ================================================== -->
  <section class="bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Why IEEE? /"
        subtitle="Unlocking tangible technical, professional, and career benefits through branch membership."
      />

      <!-- Benefits Grid -->
      <div class="mb-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          whyIeeeBenefits.map((benefit) => {
            const Icon = benefit.icon;
            return (
              <div class="group flex flex-col justify-between rounded-lg border border-[#3A3A3A] bg-[#303030] p-6 transition-all duration-200 hover:-translate-y-1 hover:border-[#0077B6]">
                <div>
                  <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-[#3A3A3A] bg-[#252525] text-[#0077B6] transition-colors group-hover:bg-[#0077B6] group-hover:text-white">
                    <Icon className="w-5 h-5" />
                  </div>
                  <h3 class="mb-2 text-base font-bold text-[#F5F5F5] transition-colors group-hover:text-[#1689C9]">
                    {benefit.title}
                  </h3>
                  <p class="text-xs leading-relaxed text-[#C9C9C9] sm:text-sm">{benefit.desc}</p>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Join CTA Banner -->
      <div
        class="mx-auto max-w-4xl rounded-lg border border-[#3A3A3A] bg-[#1F1F1F] p-8 text-center sm:p-12"
      >
        <div
          class="mb-3 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-[#0077B6]"
        >
          <ShieldCheck className="h-4 w-4" />
          <span>Become a Member Today</span>
        </div>
        <h2 class="mb-4 text-2xl font-bold tracking-tight text-[#F5F5F5] sm:text-3xl">
          Ready to Accelerate Your Engineering Journey?
        </h2>
        <p class="mx-auto mb-8 max-w-2xl text-sm leading-relaxed text-[#C9C9C9] sm:text-base">
          Join the IEEE GBPIET Student Branch to collaborate on cutting-edge hardware, build lasting
          peer networks, and gain recognized leadership credentials.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="https://www.ieee.org/membership/join/index.html"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md bg-[#0077B6] px-6 py-3 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[#1689C9]"
          >
            <span>Join IEEE Global</span>
            <ArrowRight className="h-4 w-4" />
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-md border border-[#3A3A3A] bg-[#303030] px-6 py-3 text-xs font-bold uppercase tracking-wider text-[#F5F5F5] transition-all hover:-translate-y-0.5 hover:bg-[#3A3A3A] hover:text-white"
          >
            <span>Contact Branch Team</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
