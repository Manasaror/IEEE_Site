---
/**
 * Activities Page — /activities
 * Official showcase of events, workshops, hackathons, robotics projects, and outreach.
 * Clean, structured university engineering aesthetic adhering to master design tokens.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ActivitiesFilterGrid from '@components/activities/ActivitiesFilterGrid';
import { featuredActivity, activitiesList } from '@data/activities';
import { Calendar, MapPin, ArrowRight, Sparkles, Terminal, Cpu, Trophy, Users } from 'lucide-react';

const activityTracks = [
  {
    title: 'Workshops & Bootcamps',
    desc: 'Intensive hardware training in Altium PCB layout, ROS 2 robotics middleware, and TinyML embedded inference.',
    icon: Cpu,
    count: '30+ Sessions',
  },
  {
    title: 'Hackathons & Contests',
    desc: 'High-octane competitive sprints including 36-hour Himalayan TechHacks and national Micromouse maze solving.',
    icon: Trophy,
    count: '₹1.5L+ Prizes',
  },
  {
    title: 'Flagship Projects',
    desc: 'Multi-semester student engineering initiatives including Project AURORA planetary rover and LoRa microgrids.',
    icon: Terminal,
    count: '6 Core Labs',
  },
  {
    title: 'Community & Outreach',
    desc: 'Mentoring rural Garhwal schools through EmpowerSTEM, campus e-waste reclamation, and WIE diversity initiatives.',
    icon: Users,
    count: '500+ Reached',
  },
];
---

<BaseLayout
  title="Activities | IEEE GBPIET Student Branch"
  description="Explore technical workshops, hackathons, competitions, engineering projects, and community outreach at the IEEE GBPIET Student Branch."
>
  <!-- ================================================== -->
  <!-- 1. PAGE HERO                                       -->
  <!-- ================================================== -->
  <section
    class="relative w-full overflow-hidden border-b border-[#3A3A3A] bg-[#1F1F1F] py-16 text-[#F5F5F5] sm:py-20 lg:py-24"
  >
    <div class="relative z-10 mx-auto max-w-[1280px] px-4 text-center sm:px-6 lg:px-8">
      <!-- Branch Badge -->
      <div
        class="mb-4 inline-flex items-center gap-2 rounded border border-[#1E5F88]/40 bg-[#1E5F88]/20 px-3 py-1 font-mono text-xs text-[#0077B6]"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#0077B6]"></span>
        <span>IEEE STUDENT BRANCH • STB64581</span>
      </div>

      <h1
        class="mb-4 text-3xl font-extrabold leading-tight tracking-tight text-[#F5F5F5] sm:text-5xl lg:text-6xl"
      >
        ACTIVITIES
      </h1>

      <p class="mx-auto max-w-2xl text-base leading-relaxed text-[#C9C9C9] sm:text-xl">
        Explore the events, workshops, projects and initiatives of IEEE GBPIET.
      </p>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 2. TRACKS / PILLARS OVERVIEW                       -->
  <!-- ================================================== -->
  <section class="border-b border-[#3A3A3A] bg-[#252525] py-10">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
        {
          activityTracks.map((track) => {
            const Icon = track.icon;
            return (
              <div class="flex items-start gap-3.5 rounded-lg border border-[#3A3A3A] bg-[#303030] p-4">
                <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded border border-[#1E5F88]/40 bg-[#1E5F88]/20 text-[#0077B6]">
                  <Icon className="w-4 h-4" />
                </div>
                <div class="min-w-0">
                  <div class="mb-1 flex items-center justify-between gap-2">
                    <h3 class="truncate font-mono text-xs font-bold uppercase tracking-wider text-[#F5F5F5]">
                      {track.title}
                    </h3>
                  </div>
                  <p class="line-clamp-2 text-[11px] leading-relaxed text-[#C9C9C9]">
                    {track.desc}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 3. FEATURED ACTIVITY SECTION                       -->
  <!-- ================================================== -->
  <section class="border-b border-[#3A3A3A] bg-[#292929] py-14 text-[#F5F5F5] sm:py-16">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-center justify-between">
        <div
          class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-[#0077B6]"
        >
          <Sparkles className="h-4 w-4" />
          <span>Featured Initiative</span>
        </div>
        <span class="font-mono text-xs text-[#9CA3AF]"> Flagship Competition • 2026 </span>
      </div>

      <!-- Large Featured Activity Card -->
      <article
        class="grid grid-cols-1 overflow-hidden rounded-lg border border-[#3A3A3A] bg-[#303030] shadow-lg transition-all duration-300 hover:border-[#0077B6] lg:grid-cols-12"
      >
        <!-- Left: Large Image Container -->
        <div
          class="group relative min-h-[300px] overflow-hidden bg-[#1F1F1F] sm:min-h-[380px] lg:col-span-7"
        >
          <img
            src={featuredActivity.image}
            alt={featuredActivity.title}
            class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            loading="eager"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-[#303030] via-transparent to-transparent lg:hidden"
          >
          </div>

          <!-- Badges on Image -->
          <div class="absolute left-4 top-4 flex flex-wrap gap-2">
            <span
              class="rounded bg-[#0077B6] px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-white shadow-sm"
            >
              {featuredActivity.category}
            </span>
            <span
              class="rounded border border-[#3A3A3A] bg-[#1F1F1F]/90 px-3 py-1 font-mono text-xs text-[#C9C9C9] backdrop-blur-sm"
            >
              {featuredActivity.time}
            </span>
          </div>
        </div>

        <!-- Right: Activity Details & CTA -->
        <div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-5 lg:p-10">
          <div>
            <!-- Meta Info -->
            <div class="mb-4 space-y-2">
              <div class="flex items-center gap-2 font-mono text-xs text-[#0077B6]">
                <Calendar className="h-4 w-4 shrink-0" />
                <span>{featuredActivity.date}</span>
              </div>
              <div class="flex items-start gap-2 font-mono text-xs text-[#9CA3AF]">
                <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-[#9CA3AF]" />
                <span>{featuredActivity.location}</span>
              </div>
            </div>

            <!-- Title -->
            <h2
              class="mb-4 text-xl font-bold leading-snug tracking-tight text-[#F5F5F5] sm:text-2xl lg:text-3xl"
            >
              {featuredActivity.title}
            </h2>

            <!-- Description -->
            <p class="mb-6 text-sm leading-relaxed text-[#C9C9C9]">
              {featuredActivity.description}
            </p>

            <!-- Tags -->
            {
              featuredActivity.tags && (
                <div class="mb-8 flex flex-wrap gap-1.5">
                  {featuredActivity.tags.map((tag) => (
                    <span class="rounded border border-[#3A3A3A] bg-[#252525] px-2.5 py-1 font-mono text-xs text-[#C9C9C9]">
                      {tag}
                    </span>
                  ))}
                </div>
              )
            }
          </div>

          <!-- CTA Button -->
          <div class="border-t border-[#3A3A3A] pt-4">
            <a
              href={featuredActivity.ctaLink || '#'}
              class="inline-flex items-center gap-2 rounded-md bg-[#0077B6] px-6 py-3 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[#1689C9] focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
            >
              <span>{featuredActivity.ctaText || 'VIEW DETAILS'}</span>
              <ArrowRight className="h-4 w-4" />
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ================================================== -->
  <!-- 4. ALL ACTIVITIES & CATEGORY FILTERS               -->
  <!-- ================================================== -->
  <section class="bg-[#292929] py-16 text-[#F5F5F5] sm:py-20">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="All Activities /"
        subtitle="Filter through technical workshops, competitive hackathons, ongoing hardware research, and student community outreach."
      />

      <!-- Interactive React Filter Grid Island -->
      <ActivitiesFilterGrid client:load activities={activitiesList} />
    </div>
  </section>
</BaseLayout>
