---
/**
 * BaseLayout
 * Global layout inherited by every page. Provides shared navigation,
 * footer, metadata/SEO, a responsive container, and the global stylesheet.
 *
 * Usage:
 *   ---
 *   import BaseLayout from '@layouts/BaseLayout.astro';
 *   ---
 *   <BaseLayout title="Projects & Workshops">
 *     <h1>Projects & Workshops</h1>
 *   </BaseLayout>
 */
import '@styles/globals.css';
import Seo from '@components/common/Seo.astro';
import Navbar from '@components/navigation/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import type { SeoProps } from '@/types/seo';

interface Props extends SeoProps {}

const { title, description, canonicalUrl, ogImage, ogType, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <Seo
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body
    class="flex min-h-screen flex-col bg-[#292929] text-[#F5F5F5] selection:bg-[#0077B6]/30 selection:text-white"
  >
    <a href="#main-content" class="sr-only-focusable">Skip to main content</a>

    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
