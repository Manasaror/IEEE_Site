---
/**
 * Input
 * Accessible, label-paired text input placeholder used by forms
 * (e.g. ContactForm). Keyboard and screen-reader ready via explicit
 * label association and aria-describedby for error text.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  placeholder?: string;
  required?: boolean;
  error?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  placeholder,
  required = false,
  error,
  class: className = '',
} = Astro.props;

const describedBy = error ? `${id}-error` : undefined;
---

<div class:list={['flex flex-col gap-1', className]}>
  <label for={id}>
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </label>

  {
    type === 'textarea' ? (
      <textarea
        id={id}
        name={name}
        placeholder={placeholder}
        required={required}
        aria-required={required}
        aria-describedby={describedBy}
        rows={5}
        class="rounded-md border"
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        placeholder={placeholder}
        required={required}
        aria-required={required}
        aria-describedby={describedBy}
        class="rounded-md border"
      />
    )
  }

  {
    error && (
      <p id={`${id}-error`} role="alert">
        {error}
      </p>
    )
  }
</div>
