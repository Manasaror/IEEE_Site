---
/**
 * Badge
 * Small label used for tags, statuses, or categories (e.g. project tags).
 */
import type { BadgeVariant } from '@/types/content';

interface Props {
  variant?: BadgeVariant;
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;
---

<span
  data-variant={variant}
  class:list={['inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium', className]}
>
  <slot />
</span>
