---
/**
 * SectionHeading.astro
 * Standardized heading system with signature blue slash accent.
 *
 * Props:
 *   title: Section title (e.g. "Events", "About Us", "Projects & Innovation")
 *   subtitle: Optional descriptive text
 *   alignment: 'left' | 'center' (defaults to 'left')
 *   class: Optional additional classes
 */
interface Props {
  title: string;
  subtitle?: string;
  alignment?: 'left' | 'center';
  class?: string;
}

const { title, subtitle, alignment = 'left', class: className = '' } = Astro.props;

// Strip trailing slash if caller passed "About Us /" so we don't render double slashes
const cleanTitle = title.replace(/\s*\/$/, '');
const isCentered = alignment === 'center';
---

<div class:list={['mb-10 sm:mb-12', isCentered ? 'mx-auto text-center' : 'text-left', className]}>
  <h2
    class="inline-flex flex-wrap items-baseline gap-2 text-3xl font-bold tracking-tight text-[#F5F5F5] sm:text-4xl"
  >
    <span>{cleanTitle}</span>
    <span class="select-none text-3xl font-black text-[#0077B6] sm:text-4xl" aria-hidden="true"
      >/</span
    >
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          'mt-3 text-base leading-relaxed text-[#C9C9C9] sm:text-lg',
          isCentered ? 'mx-auto max-w-2xl' : 'max-w-3xl',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
