---
/**
 * Card
 * Generic content container used as the base for TeamCard, ProjectCard,
 * and EventCard. Minimal placeholder styling only.
 */
interface Props {
  class?: string;
  as?: keyof HTMLElementTagNameMap;
}

const { class: className = '', as: Tag = 'div' } = Astro.props;
---

<Tag class:list={['rounded-lg border', className]}>
  <slot />
</Tag>
