---
/**
 * Hero.astro
 * Engineering-focused Hero section with dark overlay and centered typography.
 * Height: Desktop 400-500px, Tablet ~380px, Mobile 350-420px.
 */
import HeroContent from './HeroContent';
---

<section
  class="relative flex h-[380px] w-full items-center justify-center overflow-hidden bg-[#1F1F1F] sm:h-[420px] md:h-[460px] lg:h-[500px]"
>
  <!-- Background Engineering Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero_engineering_lab.jpg"
      alt="IEEE GBPIET Engineering Innovation Laboratory"
      class="h-full w-full object-cover object-center"
      loading="eager"
    />
    <!-- Controlled Dark Charcoal Overlay (approx. 65% opacity) -->
    <div class="absolute inset-0 bg-[#1F1F1F]/65 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-black/55"></div>
  </div>

  <!-- Centered Hero Content Island -->
  <div class="relative z-10 mx-auto w-full max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <HeroContent client:load />
  </div>
</section>
