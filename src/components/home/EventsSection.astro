---
/**
 * EventsSection.astro
 * Events section with SectionHeading and reusable EventCard components.
 * 3 columns desktop, 2 columns tablet, 1 column mobile.
 */
import SectionHeading from '@components/ui/SectionHeading.astro';
import EventCard from '@components/cards/EventCard.astro';
import { events } from '@data/events';
---

<section
  id="events"
  class="border-b border-[#3A3A3A] bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Events /"
      subtitle="Stay updated with workshops, competitions, technical sessions and activities organized by IEEE GBPIET."
    />

    <!-- Events 3-Column Grid -->
    <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
      {events.map((evt) => <EventCard event={evt} />)}
    </div>
  </div>
</section>
