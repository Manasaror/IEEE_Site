---
/**
 * TeamSection.astro
 * Leadership showcase featuring Branch Counselor, Executive Officers, and Technical Leads.
 * Uses SectionHeading and TeamCard.
 */
import SectionHeading from '@components/ui/SectionHeading.astro';
import TeamCard from '@components/cards/TeamCard.astro';
import { teamMembers } from '@data/team';
---

<section
  id="team"
  class="border-b border-[#3A3A3A] bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Our Team /"
      subtitle="Executive leadership, faculty advisor, and technical heads guiding the IEEE GBPIET Student Branch."
    />

    <!-- Team Cards Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
      {teamMembers.map((member) => <TeamCard member={member} />)}
    </div>

    <!-- View Full Team Action -->
    <div class="mt-12 text-center">
      <a
        href="/team"
        class="inline-flex items-center gap-2 rounded-md border border-[#3A3A3A] bg-[#1E5F88] px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-all duration-150 hover:-translate-y-0.5 hover:bg-[#0077B6]"
      >
        <span>View Full Committee & Domain Leads</span>
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
