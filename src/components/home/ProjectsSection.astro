---
/**
 * ProjectsSection.astro
 * Projects & Innovation section displaying student-led hardware and software projects.
 * 3 columns desktop, 2 columns tablet, 1 column mobile.
 */
import SectionHeading from '@components/ui/SectionHeading.astro';
import ProjectCard from '@components/cards/ProjectCard.astro';
import { projects } from '@data/projects';
---

<section
  id="projects"
  class="border-b border-[#3A3A3A] bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Projects & Innovation /"
      subtitle="Explore the innovative projects developed by IEEE GBPIET students."
    />

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>

    <!-- Bottom Action to Subpage -->
    <div class="mt-12 text-center">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 rounded-md border border-[#3A3A3A] bg-[#1E5F88] px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-all duration-150 hover:-translate-y-0.5 hover:bg-[#0077B6]"
      >
        <span>View All Technical Projects</span>
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
