---
/**
 * WorkshopsSection.astro
 * Workshops & Learning section showcasing hands-on technical bootcamps.
 * Background: #292929 with #303030 cards and #3A3A3A borders.
 */
import SectionHeading from '@components/ui/SectionHeading.astro';
import { workshops } from '@data/workshops';
---

<section
  id="workshops"
  class="border-b border-[#3A3A3A] bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Workshops & Learning /"
      subtitle="Hands-on technical workshops and bootcamps led by student leads and domain specialists."
    />

    <!-- Workshops Grid -->
    <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        workshops.map((workshop) => (
          <article class="group flex flex-col justify-between rounded-lg border border-[#3A3A3A] bg-[#303030] p-6 transition-all duration-200 hover:-translate-y-1 hover:border-[#0077B6]">
            <div>
              <div class="mb-4 flex items-center justify-between gap-2">
                <span class="rounded bg-[#1E5F88] px-2 py-0.5 font-mono text-xs font-semibold uppercase tracking-wider text-white">
                  {workshop.category}
                </span>
                <span class="rounded border border-[#3A3A3A] bg-[#222222] px-2 py-0.5 font-mono text-xs text-[#9CA3AF]">
                  {workshop.level}
                </span>
              </div>

              <h3 class="mb-2 text-lg font-bold text-[#F5F5F5] transition-colors group-hover:text-[#1689C9] sm:text-xl">
                {workshop.title}
              </h3>

              <p class="mb-5 line-clamp-3 text-sm leading-relaxed text-[#C9C9C9]">
                {workshop.description}
              </p>

              <div class="mb-6 flex flex-wrap gap-1.5">
                {workshop.tools.map((tool) => (
                  <span class="rounded border border-[#3A3A3A] bg-[#252525] px-2 py-0.5 font-mono text-[11px] text-[#9CA3AF]">
                    {tool}
                  </span>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-between border-t border-[#3A3A3A] pt-4 text-xs">
              <span class="font-mono text-[#9CA3AF]">{workshop.duration}</span>

              <a
                href="/contact"
                class="inline-flex items-center gap-1 font-bold uppercase tracking-wider text-[#0077B6] transition-colors group-hover:text-[#1689C9]"
              >
                <span>Enroll</span>
                <svg
                  class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
