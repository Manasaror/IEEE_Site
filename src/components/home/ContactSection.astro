---
/**
 * ContactSection.astro
 * Contact & Branch Inquiries section with SectionHeading, branch details, and ContactForm island.
 * Background: #292929 with #303030 card styling.
 */
import { MapPin, Mail, Globe } from 'lucide-react';
import { LinkedinIcon, GithubIcon, InstagramIcon } from '@components/common/Icons';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ContactForm from '@components/forms/ContactForm';
---

<section id="contact" class="bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Contact /"
      subtitle="Connect with the IEEE GBPIET executive board, faculty advisor, or technical project leads."
    />

    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Branch Info (Left, 5 Cols) -->
      <div class="space-y-6 lg:col-span-5">
        <p class="text-base leading-relaxed text-[#C9C9C9]">
          Whether you are a prospective student member, faculty researcher, industry partner, or
          alumni sponsor exploring technical collaborations, we welcome your inquiry.
        </p>

        <!-- Details List -->
        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-4 rounded-lg border border-[#3A3A3A] bg-[#303030] p-4">
            <div class="mt-0.5 shrink-0 rounded-md bg-[#1E5F88] p-2.5 text-white">
              <MapPin className="h-5 w-5" />
            </div>
            <div>
              <div class="font-mono text-[11px] font-bold uppercase text-[#9CA3AF]">
                Campus Location
              </div>
              <div class="mt-0.5 text-sm font-bold text-[#F5F5F5]">
                Govind Ballabh Pant Institute of Engineering & Technology
              </div>
              <div class="mt-0.5 text-xs text-[#C9C9C9]">
                Ghurdauri, Pauri Garhwal, Uttarakhand — 246194, India
              </div>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-lg border border-[#3A3A3A] bg-[#303030] p-4">
            <div class="mt-0.5 shrink-0 rounded-md bg-[#1E5F88] p-2.5 text-white">
              <Mail className="h-5 w-5" />
            </div>
            <div>
              <div class="font-mono text-[11px] font-bold uppercase text-[#9CA3AF]">
                Official Correspondence
              </div>
              <a
                href="mailto:ieee@gbpiet.ac.in"
                class="mt-0.5 block text-sm font-bold text-[#0077B6] transition-colors hover:text-[#1689C9]"
              >
                ieee@gbpiet.ac.in
              </a>
              <a
                href="mailto:counselor.ieee@gbpiet.ac.in"
                class="mt-0.5 block text-xs text-[#C9C9C9] hover:underline"
              >
                counselor.ieee@gbpiet.ac.in
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-lg border border-[#3A3A3A] bg-[#303030] p-4">
            <div class="mt-0.5 shrink-0 rounded-md bg-[#1E5F88] p-2.5 text-white">
              <Globe className="h-5 w-5" />
            </div>
            <div>
              <div class="font-mono text-[11px] font-bold uppercase text-[#9CA3AF]">
                IEEE Affiliation
              </div>
              <div class="mt-0.5 text-sm font-semibold text-[#F5F5F5]">
                IEEE Region 10 (Asia-Pacific)
              </div>
              <div class="mt-0.5 text-xs text-[#C9C9C9]">
                IEEE Uttar Pradesh Section • Roorkee Sub-section
              </div>
            </div>
          </div>
        </div>

        <!-- Social Networks -->
        <div class="pt-2">
          <div class="mb-3 font-mono text-xs font-bold uppercase text-[#9CA3AF]">
            Social Channels
          </div>
          <div class="flex items-center gap-2.5">
            <a
              href="https://discord.gg/ieee"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border border-[#3A3A3A] bg-[#303030] p-2.5 text-[#C9C9C9] transition-all hover:border-[#0077B6] hover:text-white"
              aria-label="Discord"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                ></path>
              </svg>
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border border-[#3A3A3A] bg-[#303030] p-2.5 text-[#C9C9C9] transition-all hover:border-[#0077B6] hover:text-[#0077B6]"
              aria-label="LinkedIn"
            >
              <LinkedinIcon className="h-4 w-4" />
            </a>
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border border-[#3A3A3A] bg-[#303030] p-2.5 text-[#C9C9C9] transition-all hover:border-[#0077B6] hover:text-[#F5F5F5]"
              aria-label="GitHub"
            >
              <GithubIcon className="h-4 w-4" />
            </a>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border border-[#3A3A3A] bg-[#303030] p-2.5 text-[#C9C9C9] transition-all hover:border-pink-400 hover:text-pink-400"
              aria-label="Instagram"
            >
              <InstagramIcon className="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      <!-- Form Island (Right, 7 Cols) -->
      <div class="lg:col-span-7">
        <ContactForm client:visible />
      </div>
    </div>
  </div>
</section>
