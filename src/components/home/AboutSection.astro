---
/**
 * AboutSection.astro
 * Two-column split layout for About Us and Get Involved with 1px vertical divider.
 * Background: #292929 (Dark charcoal).
 */
import { LinkedinIcon, InstagramIcon } from '@components/common/Icons';
---

<section
  id="about"
  class="border-b border-[#3A3A3A] bg-[#292929] py-16 text-[#F5F5F5] sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-0 lg:divide-x lg:divide-[#3A3A3A]"
    >
      <!-- LEFT COLUMN: About Us (Approx 50%) -->
      <div class="lg:pr-12 xl:pr-16">
        <h2
          class="mb-6 inline-flex items-baseline gap-2 text-3xl font-bold tracking-tight text-[#F5F5F5] sm:text-4xl"
        >
          <span>About Us</span>
          <span class="select-none font-black text-[#0077B6]" aria-hidden="true">/</span>
        </h2>

        <div class="max-w-xl space-y-4 text-base leading-relaxed text-[#C9C9C9]">
          <p>
            IEEE GBPIET Student Branch is a vibrant community of students passionate about
            technology, innovation and engineering.
          </p>
          <p>
            Our mission is to provide students with opportunities to explore emerging technologies,
            develop practical skills, work on impactful projects and connect with a global community
            of engineers.
          </p>
          <p>
            Through workshops, technical events, competitions and collaborative projects, IEEE
            GBPIET empowers students to innovate, learn and grow beyond the classroom.
          </p>
        </div>
      </div>

      <!-- RIGHT COLUMN: Get Involved (Approx 50%) -->
      <div class="lg:pl-12 xl:pl-16">
        <h2
          class="mb-6 inline-flex items-baseline gap-2 text-3xl font-bold tracking-tight text-[#F5F5F5] sm:text-4xl"
        >
          <span>Get Involved</span>
          <span class="select-none font-black text-[#0077B6]" aria-hidden="true">/</span>
        </h2>

        <p class="mb-8 max-w-xl text-base leading-relaxed text-[#C9C9C9]">
          Stay connected with IEEE GBPIET and become part of a community focused on technology,
          innovation and engineering.
        </p>

        <!-- Action Buttons Grid / Wrap -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4">
          <!-- Discord -->
          <a
            href="https://discord.gg/ieee"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-md bg-[#0077B6] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-[#1689C9]"
          >
            <svg
              class="h-4 w-4 shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
              ></path>
            </svg>
            <span>Discord</span>
          </a>

          <!-- Newsletter -->
          <a
            href="/contact"
            class="inline-flex items-center gap-2.5 rounded-md bg-[#0077B6] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-[#1689C9]"
          >
            <svg
              class="h-4 w-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>Newsletter</span>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-md bg-[#0077B6] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-[#1689C9]"
          >
            <InstagramIcon className="h-4 w-4 shrink-0" />
            <span>Instagram</span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-md bg-[#0077B6] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-[#1689C9]"
          >
            <LinkedinIcon className="h-4 w-4 shrink-0" />
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
