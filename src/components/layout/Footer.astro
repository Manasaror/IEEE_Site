---
/**
 * Footer.astro
 * Official Footer for IEEE GBPIET Student Branch.
 * Background: #1F1F1F (Darker background) with #3A3A3A borders.
 */
import { Mail } from 'lucide-react';
import { LinkedinIcon, GithubIcon, InstagramIcon } from '@components/common/Icons';

const currentYear = 2026;
---

<footer class="mt-auto border-t border-[#3A3A3A] bg-[#1F1F1F] text-[#C9C9C9]">
  <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div
      class="grid grid-cols-1 gap-10 border-b border-[#3A3A3A] pb-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-12"
    >
      <!-- Brand & Mission (5 Cols) -->
      <div class="space-y-4 lg:col-span-5">
        <a href="/" class="flex items-center gap-3 text-[#F5F5F5]">
          <div
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded border border-white/20 bg-[#1E5F88] p-1.5"
          >
            <img
              src="/logos/ieee-diamond.svg"
              alt="IEEE Logo"
              class="h-full w-full object-contain"
              width="36"
              height="36"
            />
          </div>
          <div>
            <div class="text-lg font-bold leading-none text-[#F5F5F5]">IEEE at GBPIET</div>
            <div class="mt-0.5 font-mono text-[10px] uppercase tracking-wider text-[#9CA3AF]">
              Student Branch • STB64581
            </div>
          </div>
        </a>

        <p class="max-w-sm text-sm leading-relaxed text-[#C9C9C9]">
          Govind Ballabh Pant Institute of Engineering and Technology, Pauri Garhwal. Empowering
          students to innovate, collaborate, and engineer real-world technical solutions.
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-2.5 pt-2">
          <a
            href="https://discord.gg/ieee"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded border border-[#3A3A3A] bg-[#292929] p-2 text-[#C9C9C9] transition-colors hover:bg-[#1E5F88] hover:text-white"
            aria-label="Discord"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
              ></path>
            </svg>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded border border-[#3A3A3A] bg-[#292929] p-2 text-[#C9C9C9] transition-colors hover:bg-[#1E5F88] hover:text-white"
            aria-label="LinkedIn"
          >
            <LinkedinIcon className="h-4 w-4" />
          </a>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded border border-[#3A3A3A] bg-[#292929] p-2 text-[#C9C9C9] transition-colors hover:bg-[#1E5F88] hover:text-white"
            aria-label="GitHub"
          >
            <GithubIcon className="h-4 w-4" />
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded border border-[#3A3A3A] bg-[#292929] p-2 text-[#C9C9C9] transition-colors hover:bg-[#1E5F88] hover:text-white"
            aria-label="Instagram"
          >
            <InstagramIcon className="h-4 w-4" />
          </a>
          <a
            href="mailto:ieee@gbpiet.ac.in"
            class="rounded border border-[#3A3A3A] bg-[#292929] p-2 text-[#C9C9C9] transition-colors hover:bg-[#1E5F88] hover:text-white"
            aria-label="Email IEEE GBPIET"
          >
            <Mail className="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Quick Links (3 Cols) -->
      <div class="lg:col-span-3">
        <div
          class="mb-4 flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-[#F5F5F5]"
        >
          <span>Quick Links</span>
          <span class="text-[#0077B6]">/</span>
        </div>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/projects" class="text-[#C9C9C9] transition-colors hover:text-[#0077B6]">
              Projects
            </a>
          </li>
          <li>
            <a href="/#events" class="text-[#C9C9C9] transition-colors hover:text-[#0077B6]">
              Events
            </a>
          </li>
          <li>
            <a href="/#workshops" class="text-[#C9C9C9] transition-colors hover:text-[#0077B6]">
              Workshops
            </a>
          </li>
          <li>
            <a href="/team" class="text-[#C9C9C9] transition-colors hover:text-[#0077B6]">
              Our Team
            </a>
          </li>
          <li>
            <a href="/contact" class="text-[#C9C9C9] transition-colors hover:text-[#0077B6]">
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Organization & Affiliation (4 Cols) -->
      <div class="lg:col-span-4">
        <div
          class="mb-4 flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-[#F5F5F5]"
        >
          <span>Affiliation</span>
          <span class="text-[#0077B6]">/</span>
        </div>
        <p class="mb-3 text-xs leading-relaxed text-[#9CA3AF]">
          IEEE Uttar Pradesh Section • Roorkee Sub-section • IEEE Region 10 (Asia-Pacific)
        </p>
        <p class="text-xs leading-relaxed text-[#9CA3AF]">
          Govind Ballabh Pant Institute of Engineering & Technology, Ghurdauri, Pauri Garhwal,
          Uttarakhand 246194
        </p>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div
      class="flex flex-col items-center justify-between gap-3 pt-6 text-xs text-[#9CA3AF] sm:flex-row"
    >
      <p>© {currentYear} IEEE GBPIET Student Branch</p>
      <a
        href="#main-content"
        class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider transition-colors hover:text-[#F5F5F5]"
      >
        <span>Back to top</span>
        <span class="text-[#0077B6]">↑</span>
      </a>
    </div>
  </div>
</footer>
