---
/**
 * Footer
 * Shared site footer. Structure only — placeholders for the IEEE logo,
 * quick links, social links, and copyright. Detailed styling is deferred.
 */
import Container from '@components/layout/Container.astro';
import { footerLinks } from '@data/navigation';
import { siteConfig } from '@lib/site';

const currentYear = new Date().getFullYear();

const socialLinks = [
  { label: 'Instagram', href: siteConfig.social.instagram },
  { label: 'LinkedIn', href: siteConfig.social.linkedin },
  { label: 'Twitter', href: siteConfig.social.twitter },
  { label: 'GitHub', href: siteConfig.social.github },
].filter((link) => link.href);
---

<footer>
  <Container class="grid gap-8 py-12 md:grid-cols-3">
    <div>
      <!-- IEEE Logo placeholder -->
      <img src="/logos/ieee-logo-placeholder.svg" alt="IEEE GBPIET Student Branch logo" width="120" height="40" />
      <p>{siteConfig.description}</p>
    </div>

    <nav aria-label="Footer quick links">
      <h2>Quick Links</h2>
      <ul>
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2>Follow Us</h2>
      <ul>
        {
          socialLinks.length > 0 ? (
            socialLinks.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener noreferrer">
                  {social.label}
                </a>
              </li>
            ))
          ) : (
            <li>Social links coming soon.</li>
          )
        }
      </ul>
    </div>
  </Container>

  <Container class="border-t py-6">
    <p>&copy; {currentYear} {siteConfig.name}. All rights reserved.</p>
  </Container>
</footer>
