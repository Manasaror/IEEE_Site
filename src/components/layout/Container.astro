---
/**
 * Container
 * Responsive width-constrained wrapper. Wrap page/section content in this
 * instead of repeating max-width + padding utility classes.
 */
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['site-container', className]}>
  <slot />
</Tag>
