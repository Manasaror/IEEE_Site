---
/**
 * Navbar.astro
 * Official Navigation Bar for IEEE GBPIET Student Branch.
 * Clean blue horizontal navigation with authentic IEEE engineering identity.
 */
import { primaryNav } from '@data/navigation';
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-[#164866] bg-[#1E5F88] shadow-sm">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between sm:h-16">
      <!-- Left: Logo & Organization Brand -->
      <a
        href="/"
        class="flex items-center gap-3 rounded text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
        aria-label="IEEE GBPIET Student Branch Home"
      >
        <div
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded border border-white/20 bg-white/10 p-1.5 sm:h-9 sm:w-9"
        >
          <img
            src="/logos/ieee-diamond.svg"
            alt="IEEE Logo"
            class="h-full w-full object-contain"
            width="36"
            height="36"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold leading-none tracking-tight text-white sm:text-lg">
            IEEE at GBPIET
          </span>
          <span class="mt-0.5 font-mono text-[10px] uppercase tracking-wider text-white/70">
            Student Branch • STB64581
          </span>
        </div>
      </a>

      <!-- Right: Desktop Navigation Links -->
      <nav class="hidden items-center gap-1 md:flex lg:gap-2" aria-label="Main Navigation">
        {
          primaryNav.map((item) => {
            const isCurrent =
              item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href) && item.href !== '/';

            return (
              <a
                href={item.href}
                class:list={[
                  'rounded px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition-colors duration-150 lg:text-[13px]',
                  isCurrent
                    ? 'bg-black/15 text-white shadow-inner'
                    : 'text-white/90 hover:bg-white/10 hover:text-white',
                ]}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Mobile Menu Button -->
      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="mobile-nav-toggle"
          class="rounded p-2 text-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
          aria-label="Toggle navigation menu"
        >
          <!-- Hamburger icon -->
          <svg
            id="icon-menu"
            class="block h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <!-- Close icon -->
          <svg
            id="icon-close"
            class="hidden h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden space-y-1 border-t border-[#164866] bg-[#1A5276] px-4 py-4 transition-all duration-200 md:hidden"
    role="region"
    aria-label="Mobile Navigation"
  >
    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link block rounded px-3 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-white/10"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  function setupMobileNav() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const menu = document.getElementById('mobile-nav-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !menu || !iconMenu || !iconClose) return;

    let isOpen = false;

    function setOpen(open: boolean) {
      isOpen = open;
      toggleBtn?.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        menu?.classList.remove('hidden');
        iconMenu?.classList.remove('block');
        iconMenu?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        iconClose?.classList.add('block');
      } else {
        menu?.classList.add('hidden');
        iconMenu?.classList.remove('hidden');
        iconMenu?.classList.add('block');
        iconClose?.classList.remove('block');
        iconClose?.classList.add('hidden');
      }
    }

    toggleBtn.addEventListener('click', () => {
      setOpen(!isOpen);
    });

    // Close on navigation link click
    links.forEach((link) => {
      link.addEventListener('click', () => {
        setOpen(false);
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        setOpen(false);
        toggleBtn.focus();
      }
    });

    // Close when window resized to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        setOpen(false);
      }
    });
  }

  // Support both direct load and Astro view transitions
  setupMobileNav();
  document.addEventListener('astro:page-load', setupMobileNav);
</script>
