---
/**
 * ProjectCard.astro
 * Standard IEEE GBPIET student project card.
 * Dark, technical, minimal, consistent aspect ratio, and subtle tech tags.
 */
import type { Project } from '@/types/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const imageSrc = project.imageUrl || '/images/hero_engineering_lab.jpg';
const linkHref = project.liveUrl || project.repoUrl || `/projects#${project.id}`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-[#3A3A3A] bg-[#303030] transition-all duration-200 hover:-translate-y-1 hover:border-[#0077B6]"
>
  <!-- Project Image -->
  <div class="relative h-48 w-full overflow-hidden bg-[#1F1F1F] sm:h-52">
    <img
      src={imageSrc}
      alt={`Project preview for ${project.title}`}
      class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#303030] via-transparent to-transparent opacity-80"
    >
    </div>

    <!-- Category Badge -->
    <div class="absolute left-3 top-3 flex items-center gap-2">
      <span
        class="rounded bg-[#1E5F88] px-2 py-0.5 font-mono text-xs font-semibold uppercase tracking-wider text-white"
      >
        {project.category}
      </span>
      {
        project.status && (
          <span class="rounded border border-[#3A3A3A] bg-[#1F1F1F]/90 px-2 py-0.5 font-mono text-xs font-medium text-[#C9C9C9]">
            {project.status}
          </span>
        )
      }
    </div>
  </div>

  <!-- Body Content -->
  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <h3
        class="mb-2 line-clamp-2 text-lg font-bold text-[#F5F5F5] transition-colors group-hover:text-[#1689C9] sm:text-xl"
      >
        {project.title}
      </h3>

      <p class="mb-4 line-clamp-3 text-sm leading-relaxed text-[#C9C9C9]">
        {project.description}
      </p>

      <!-- Tech Tags (Subtle, Muted, Technical) -->
      {
        project.tags && project.tags.length > 0 && (
          <div class="mb-5 flex flex-wrap gap-1.5">
            {project.tags.slice(0, 4).map((tag) => (
              <span class="rounded border border-[#3A3A3A] bg-[#222222] px-2 py-0.5 font-mono text-[11px] text-[#9CA3AF]">
                {tag}
              </span>
            ))}
            {project.tags.length > 4 && (
              <span class="px-1.5 py-0.5 font-mono text-[11px] text-[#9CA3AF]">
                +{project.tags.length - 4}
              </span>
            )}
          </div>
        )
      }
    </div>

    <!-- Action Link -->
    <div class="flex items-center justify-between border-t border-[#3A3A3A] pt-4">
      <a
        href={linkHref}
        class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#0077B6] transition-colors group-hover:text-[#1689C9]"
      >
        <span>View Project</span>
        <svg
          class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>

      {
        project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-xs text-[#9CA3AF] transition-colors hover:text-[#F5F5F5]"
            aria-label={`Repository for ${project.title}`}
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              />
            </svg>
            <span class="font-mono">Code</span>
          </a>
        )
      }
    </div>
  </div>
</article>
