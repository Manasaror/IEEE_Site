---
/**
 * EventCard.astro
 * Standard IEEE GBPIET event card.
 * Minimal, dark, technical, consistent aspect ratio, and subtle hover transition.
 */
import type { EventItem } from '@/types/content';

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
const imageSrc = event.imageUrl || '/images/hero_engineering_lab.jpg';
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-[#3A3A3A] bg-[#303030] transition-all duration-200 hover:-translate-y-1 hover:border-[#0077B6]"
>
  <!-- Event Image with Aspect Ratio -->
  <div class="relative h-48 w-full overflow-hidden bg-[#1F1F1F] sm:h-52">
    <img
      src={imageSrc}
      alt={`Event cover for ${event.title}`}
      class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#303030] via-transparent to-transparent opacity-80"
    >
    </div>

    <!-- Top Category & Optional Badge -->
    <div class="absolute left-3 top-3 flex items-center gap-2">
      <span
        class="rounded bg-[#1E5F88] px-2 py-0.5 font-mono text-xs font-semibold uppercase tracking-wider text-white"
      >
        {event.category}
      </span>
      {
        event.badge && (
          <span class="rounded border border-[#3A3A3A] bg-[#1F1F1F]/90 px-2 py-0.5 font-mono text-xs font-medium text-[#C9C9C9]">
            {event.badge}
          </span>
        )
      }
    </div>

    <!-- Date Badge -->
    <div
      class="absolute bottom-3 left-3 rounded border border-[#3A3A3A] bg-[#1F1F1F]/90 px-2.5 py-1 font-mono text-xs font-semibold text-[#F5F5F5]"
    >
      {event.date}
    </div>
  </div>

  <!-- Content Body -->
  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <h3
        class="mb-2 line-clamp-2 text-lg font-bold text-[#F5F5F5] transition-colors group-hover:text-[#1689C9] sm:text-xl"
      >
        {event.title}
      </h3>

      <p class="mb-4 line-clamp-3 text-sm leading-relaxed text-[#C9C9C9]">
        {event.description}
      </p>

      {
        event.location && (
          <div class="mb-4 flex items-center gap-1.5 text-xs text-[#9CA3AF]">
            <svg
              class="h-3.5 w-3.5 shrink-0 text-[#0077B6]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            <span class="truncate">{event.location}</span>
          </div>
        )
      }
    </div>

    <!-- Action Link -->
    <div class="flex items-center justify-between border-t border-[#3A3A3A] pt-4">
      <a
        href={event.registrationUrl || '/contact'}
        class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#0077B6] transition-colors group-hover:text-[#1689C9]"
      >
        <span>Learn More</span>
        <svg
          class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
      {
        event.status === 'Upcoming' && (
          <span class="inline-flex items-center gap-1 font-mono text-[11px] text-emerald-400">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
            Upcoming
          </span>
        )
      }
    </div>
  </div>
</article>
