---
/**
 * TeamCard.astro
 * Standard IEEE GBPIET team card.
 * Minimal, professional, consistent image ratios, and clean social icons.
 */
import type { TeamMember } from '@/types/content';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const initials = member.name
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('');
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-[#3A3A3A] bg-[#303030] p-5 transition-all duration-200 hover:-translate-y-1 hover:border-[#0077B6]"
>
  <div class="mb-4 flex items-start justify-between gap-4">
    <!-- Photo or Monogram Avatar -->
    {
      member.photoUrl ? (
        <img
          src={member.photoUrl}
          alt={`Portrait of ${member.name}`}
          class="h-16 w-16 rounded-md border border-[#3A3A3A] object-cover object-center"
          loading="lazy"
        />
      ) : (
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-md border border-[#3A3A3A] bg-[#1E5F88] font-mono text-lg font-bold tracking-wider text-white">
          {initials}
        </div>
      )
    }

    <!-- Category Pill -->
    <span
      class="rounded border border-[#3A3A3A] bg-[#252525] px-2 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-[#9CA3AF]"
    >
      {member.category}
    </span>
  </div>

  <div class="flex flex-1 flex-col justify-between">
    <div>
      <h3
        class="mb-0.5 text-base font-bold text-[#F5F5F5] transition-colors group-hover:text-[#1689C9] sm:text-lg"
      >
        {member.name}
      </h3>
      <div class="mb-2 font-mono text-xs font-semibold text-[#0077B6]">
        {member.role}
      </div>
      {
        member.department && (
          <p class="mb-4 line-clamp-2 text-xs leading-relaxed text-[#9CA3AF]">
            {member.department}
          </p>
        )
      }
    </div>

    <!-- Social Links -->
    <div
      class="flex items-center justify-between border-t border-[#3A3A3A] pt-3 text-xs text-[#9CA3AF]"
    >
      <div class="flex items-center gap-3">
        {
          member.linkedinUrl && (
            <a
              href={member.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#9CA3AF] transition-colors hover:text-[#0077B6]"
              aria-label={`${member.name} LinkedIn`}
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.3a1.4 1.4 0 0 0-1.4 1.4 1.4 1.4 0 0 0 1.4 1.4 1.4 1.4 0 0 0 1.4-1.4 1.4 1.4 0 0 0-1.4-1.4z" />
              </svg>
            </a>
          )
        }
        {
          member.githubUrl && (
            <a
              href={member.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#9CA3AF] transition-colors hover:text-[#F5F5F5]"
              aria-label={`${member.name} GitHub`}
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                />
              </svg>
            </a>
          )
        }
        {
          member.email && (
            <a
              href={`mailto:${member.email}`}
              class="text-[#9CA3AF] transition-colors hover:text-[#0077B6]"
              aria-label={`Email ${member.name}`}
            >
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
            </a>
          )
        }
      </div>

      <span class="font-mono text-[10px] uppercase text-[#9CA3AF]"> IEEE Member </span>
    </div>
  </div>
</article>
